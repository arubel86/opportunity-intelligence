      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Calcular si el activo actual es una oportunidad basada en comparables de Supabase\nconst items = $input.all();\nconst prices = items.map(item => Number(item.json.price_amount)).filter(p => !isNaN(p) && p > 0);\n\n// Obtener los datos del activo actual desde el formateador PDF\nconst currentAsset = $('Normalizar & Formatear Schema').item.json;\nconst currentPrice = Number(currentAsset.price_amount);\nconst vertical = currentAsset.vertical;\n\nlet isOpportunity = false;\nlet reason = '';\nlet avgPrice = 0;\n\nif (vertical === 'vehicles') {\n  isOpportunity = currentPrice <= 25000;\n  reason = `Auto bajo límite estático de $25,000 (Precio actual: $${currentPrice.toLocaleString('en-US')})`;\n} else {\n  if (prices.length >= 3) {\n    const sum = prices.reduce((a, b) => a + b, 0);\n    avgPrice = Math.round(sum / prices.length);\n    const discount = ((avgPrice - currentPrice) / avgPrice) * 100;\n    isOpportunity = discount >= 15;\n    reason = `Precio actual ($${currentPrice.toLocaleString('en-US')}) es ${discount.toFixed(1)}% menor al promedio de la zona ($${avgPrice.toLocaleString('en-US')}) basado en ${prices.length} activos`;\n  } else {\n    isOpportunity = currentPrice <= 180000;\n    reason = `Datos insuficientes en zona. Oportunidad bajo límite estático de $180,000 (Precio actual: $${currentPrice.toLocaleString('en-US')})`;\n  }\n}\n\nreturn [{\n  json: {\n    ...currentAsset,\n    is_opportunity: isOpportunity,\n    opportunity_reason: reason,\n    avg_zone_price: avgPrice || null\n  }\n}];"
      },
