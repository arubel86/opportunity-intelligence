      },
      "id": "node-pdf-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        1080,
        540
      ]
    },
    {
      "parameters": {
        "jsCode": "// Formatear remates de PDF para Supabase con UUID determinista\nconst parsed = $json.output || $json;\nconst list = Array.isArray(parsed.remates) ? parsed.remates : [];\nconst validItems = [];\n\nconst webhookData = $('Webhook Ingesta PDF').item.json;\nconst defaultSourceName = webhookData.source_name || 'remate-bancario-pdf';\nconst defaultVertical = webhookData.vertical || 'real_estate';\n\nfunction generateDeterministicUUID(seed) {\n  let hash1 = 0x811c9dc5;\n  let hash2 = 0x5bd1e995;\n  for (let i = 0; i < seed.length; i++) {\n    const ch = seed.charCodeAt(i);\n    hash1 = Math.imul(hash1 ^ ch, 0x01000193);\n    hash2 = Math.imul(hash2 ^ (ch << 1), 0x5bd1e995);\n  }\n  const hex1 = ('00000000' + (hash1 >>> 0).toString(16)).slice(-8);\n  const hex2 = ('00000000' + (hash2 >>> 0).toString(16)).slice(-8);\n  const hex3 = ('00000000' + ((hash1 ^ hash2) >>> 0).toString(16)).slice(-8);\n  const hex4 = ('00000000' + ((hash1 + hash2) >>> 0).toString(16)).slice(-8);\n  const fullHex = (hex1 + hex2 + hex3 + hex4).slice(0, 32);\n  \n  return (\n    fullHex.substring(0, 8) + '-' +\n    fullHex.substring(8, 12) + '-' +\n    '4' + fullHex.substring(13, 16) + '-' +\n    ((parseInt(fullHex.substring(16, 18), 16) & 0x3f) | 0x80).toString(16) + fullHex.substring(18, 20) + '-' +\n    fullHex.substring(20, 32)\n  );\n}\n\nlet sourceId = webhookData.source_id;\nconst isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!sourceId || !isUuid.test(sourceId)) {\n  sourceId = generateDeterministicUUID('source::' + defaultSourceName.toLowerCase());\n}\n\nfor (const item of list) {\n  const price = Number(item.price_amount);\n  if (!item.title || isNaN(price) || price <= 0) continue;\n\n  const normalizedTitle = String(item.title)\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .trim()\n    .replace(/\\s+/g, ' ');\n\n  const folio = item.specs?.finca_folio || normalizedTitle;\n  const hashSeed = sourceId + '::' + folio;\n  const assetId = generateDeterministicUUID(hashSeed);\n\n  const loc = item.location || {};\n  const province = loc.province || 'Panamá';\n  const corregimiento = loc.corregimiento || 'Bella Vista';\n  const district = loc.district || (province === 'Panamá' ? 'Panamá' : corregimiento);\n\n  validItems.push({\n    asset_id: assetId,\n    source_id: sourceId,\n    source_listing_url: webhookData.pdf_url || '',\n    vertical: (item.vertical === 'vehicles' || defaultVertical === 'vehicles') ? 'vehicles' : 'real_estate',\n    title: String(item.title).trim(),\n    description: item.description || 'Remate extraído de documento PDF.',\n    price_amount: price,\n    price_currency: 'USD',\n    location: {\n      province: province,\n      district: district,\n      corregimiento: corregimiento\n    },\n    raw_data: {\n      specs: item.specs || {},\n      area_m2: item.specs?.area_m2 || null,\n      bedrooms: item.specs?.bedrooms || null,\n      bathrooms: item.specs?.bathrooms || null,\n      contact_phone: item.contact_phone ? String(item.contact_phone).trim() : null,\n      source_pdf: true,\n      extracted_by: 'llamaparse_groq',\n      extracted_at: new Date().toISOString()\n    },\n    status: 'active',\n    updated_at: new Date().toISOString()\n  });\n}\n\nif (validItems.length === 0) {\n  return [{\n    json: {\n      is_empty_error: true,\n      source_name: defaultSourceName,\n      pdf_url: webhookData.pdf_url || ''\n    }\n  }];\n}\n\nreturn validItems.map(obj => ({ json: obj }));"
      },
