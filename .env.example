# =============================================================================
# Hermes Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ── Supabase (Production Database) ──────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Connection string for direct PostgreSQL access (used by db:migrate)
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Redis (Queue & Cache) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Scraper Configuration ──────────────────────────────────────────────────
SCRAPER_TIMEOUT_MS=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_RATE_LIMIT_RPM=30
PLAYWRIGHT_HEADLESS=true

# ── Opportunity Engine ─────────────────────────────────────────────────────
OPPORTUNITY_SCORER_MODEL=opportunity-scorer-v1.1
SCORE_WEIGHT_PRICE_VALUE=0.30
SCORE_WEIGHT_COMPARABLES=0.25
SCORE_WEIGHT_LOCATION=0.20
SCORE_WEIGHT_LIQUIDITY=0.10
SCORE_WEIGHT_SELLER_MOTIVATION=0.10
SCORE_WEIGHT_RISK=0.05

# ── Dashboard ──────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── Environment ────────────────────────────────────────────────────────────
NODE_ENV=development
